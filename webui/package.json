{
  "name": "mybot-webapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "server": "node --watch src/server.js",
    "client": "cd web && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd web && npm run build"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "glob": "^13.0.5",
    "mongoose": "^9.1.5",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
